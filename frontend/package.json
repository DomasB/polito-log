    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
