{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "vue",
    "vitest",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.css", "**/plugins"
        ]
      }
    ]
  },
  "ignorePatterns": [
    "dist",
    "dist-ssr",
    "coverage",
    "src/api"
  ]
}
