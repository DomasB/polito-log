DATABASE_URL=postgresql://user:password@localhost:5432/polito_log
ENVIRONMENT=development
DEBUG=True

# JWT Settings
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Magic Link Settings
MAGIC_LINK_EXPIRE_MINUTES=15
FRONTEND_URL=http://localhost:5173
# CORS allows FRONTEND_URL's origin; list more (comma-separated) here if needed
# CORS_ORIGINS=https://polito-log.lt,https://www.polito-log.lt

# Magic link rate limits (per window, per email and per client IP; over the limit: 429)
MAGIC_LINK_RATE_LIMIT_WINDOW_MINUTES=60
MAGIC_LINK_RATE_LIMIT_PER_EMAIL=5
MAGIC_LINK_RATE_LIMIT_PER_IP=20
# Reverse proxies in front of the app; the client IP is read from X-Forwarded-For
# this many entries from the right (Railway: 1, 0 = ignore the header)
TRUSTED_PROXY_HOPS=1

# Email Settings (Brevo Transactional API)
# Leave BREVO_API_KEY empty for development (emails will be printed to console)
# For production on Railway, set this as a secret environment variable
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@polito-log.lt
BREVO_SENDER_NAME=Polito-Log
